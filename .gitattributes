# Line endings.
#
# Everything text is stored LF in the repository. Without this file that
# depends on each contributor's core.autocrlf, which is how a clone on a
# different OS ends up showing every file as modified.
* text=auto

# The web sources stay LF in the working tree too, not just in the repo.
# tools/sync-partials.mjs rewrites the nav and footer in place using \n, so a
# CRLF working copy would leave mixed endings inside every page and
# `npm run check` would report drift that is not really there.
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.webmanifest   text eol=lf
*.xml           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# Binary. Never convert, never try to diff as text.
*.woff2         binary
*.png           binary
*.jpg           binary
*.ico           binary
